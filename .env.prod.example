# ตัวแปรของ docker-compose.prod.yml — คัดลอกเป็น .env ที่โฟลเดอร์นี้แล้วใส่ค่าจริง
#   cp .env.prod.example .env
#
# ไฟล์ .env ถูก .gitignore ไว้แล้ว ห้าม commit เด็ดขาด (repo นี้เป็น public)
# ความลับของแอปเอง (GOOGLE_API_KEY, JWT_SECRET, ADMIN_*, SMTP_*) อยู่คนละไฟล์
# คือ backend/.env — ดู backend/.env.example

# โดเมนจริงที่ชี้มาที่เครื่องนี้แล้ว (A record) — ต้องชี้เสร็จก่อนสตาร์ต
# ไม่งั้น Let's Encrypt ออกใบรับรองไม่ได้ และห้ามใส่ https:// หรือ / ต่อท้าย
PUBLIC_DOMAIN=talentmatch.example.com

# อีเมลสำหรับ Let's Encrypt — ใช้เตือนตอนใบรับรองใกล้หมดอายุ
ACME_EMAIL=you@example.com

# ฐานข้อมูล — **ห้ามใช้ค่าเดิมของ dev (talentmatch/talentmatch)**
# รหัสผ่านสุ่มยาว: openssl rand -base64 32
POSTGRES_USER=talentmatch
POSTGRES_PASSWORD=
POSTGRES_DB=talentmatch
