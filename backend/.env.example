# TalentMatch AI — Backend environment (คัดลอกเป็น .env แล้วใส่ค่าจริง)

# Gemini (langchain-google-genai)
GOOGLE_API_KEY=your-gemini-api-key

# โมเดล (ไม่ใส่ก็ได้ — ดีฟอลต์ gemini-2.5-flash ทั้งคู่ ใช้ได้บน free tier)
# หมายเหตุ: Gemini 1.5 ตามบรีฟถูกปลดระวางแล้ว และ Pro ใช้ไม่ได้บน free tier (โควตา limit: 0)
# เมื่อมีแพลนแบบเสียเงิน ตั้ง GEMINI_COMPLEX_MODEL=gemini-2.5-pro เพื่อยกคุณภาพขั้น bias/matching
# GEMINI_DEFAULT_MODEL=gemini-2.5-flash
# GEMINI_COMPLEX_MODEL=gemini-2.5-pro

# ความทนทานต่อ rate limit (มีดีฟอลต์อยู่แล้ว ไม่ตั้งก็ได้)
# LLM_MAX_ATTEMPTS=5          # จำนวน retry สูงสุดต่อการเรียก LLM (exponential backoff)
# LLM_MAX_BACKOFF=60         # เพดานเวลาหน่วง (วินาที)
# GRAPH_MAX_CONCURRENCY=2    # จำนวนผู้สมัครที่รันกราฟพร้อมกัน (กันยิง LLM ทะลุ RPM)
# STALLED_AFTER_SEC=90       # เกินเท่านี้แล้วยังไม่มีผลวิเคราะห์ = ขึ้นป้าย "วิเคราะห์ไม่สำเร็จ" ให้กดใหม่

# คลังเวกเตอร์ (ค้นหาผู้สมัครเก่าเชิงความหมาย — app/vectors.py)
# บรีฟระบุ models/text-embedding-004 แต่คีย์ปัจจุบันเรียกไม่ได้แล้ว (ไม่อยู่ใน ListModels)
# gemini-embedding-001 คืน 3072 มิติโดยดีฟอลต์ แต่ตัดเหลือ 768 ได้ (Matryoshka)
# ⚠️ EMBEDDING_DIM ต้องตรงกับ VECTOR(n) ใน app/schema.sql เสมอ — แก้ตัวหนึ่งต้องแก้อีกตัว
#    และถ้าเปลี่ยนค่านี้ต้อง index ใหม่ทั้งหมด (scripts/backfill_embeddings.py --all)
# EMBEDDING_MODEL=models/gemini-embedding-001
# EMBEDDING_DIM=768
# EMBEDDING_MAX_CHARS=8000   # ตัดข้อความ resume ก่อน embed

# Supabase Postgres connection string (โปรดักชัน). Local dev ใช้ DATABASE_URL จาก docker-compose แทนได้
SUPABASE_DB_URL=postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres

# LangSmith tracing — ตั้ง 2 บรรทัดแรกแล้ว tracing เปิดเอง (SDK มีในตัว ไม่ต้องแก้โค้ด)
# ทุก call ของ LLM/embeddings/กราฟจะส่ง trace ขึ้น LangSmith · ปิดโดยลบคีย์หรือตั้ง =false
# SDK รองรับทั้งชื่อ LANGCHAIN_* (นี้) และ LANGSMITH_* (เวอร์ชันใหม่) — ใช้ตัวไหนก็ได้
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your-langsmith-key
LANGCHAIN_PROJECT=talentmatch-ai    # ชื่อ project ที่จะเห็นใน LangSmith UI

# ---------- ส่งอีเมล (SMTP) ----------
# Dev: docker-compose ตั้งค่าให้ชี้ MailHog อยู่แล้ว (SMTP_HOST=mailhog) ดูอีเมลที่ http://localhost:8025
# Prod: ตั้งค่าเหล่านี้ใน .env เพื่อใช้ SMTP จริง เช่น Gmail (ต้องเปิด 2FA แล้วสร้าง App Password)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_STARTTLS=true
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=your-16-char-app-password   # App Password ไม่ใช่รหัสผ่านบัญชี
# SMTP_FROM=recruit@yourcompany.com

# ---------- ลิมิตการอัปโหลด (กัน DoS) ----------
# MAX_UPLOAD_MB=10    # ขนาดสูงสุดต่อไฟล์
# MAX_FILES=20        # จำนวนไฟล์สูงสุดต่อการอัปโหลดหนึ่งครั้ง

# ---------- RAG (retrieval agent หาผู้สมัครคล้ายกัน) ----------
# feature เสริม เปิด/ปิดได้ · ใช้ embedding quota (แยกจาก chat 20/วัน) จึงเปิดทิ้งไว้ได้
# RAG_ENABLED=true      # false = โหนด retrieve_similar เป็น no-op กราฟรันเหมือนเดิม
# RAG_TOP_K=3           # จำนวนผู้สมัครคล้ายที่ดึงมา

# ---------- Auth (ล็อกอิน) ----------
# JWT_SECRET จำเป็นเสมอ — โปรดักชันต้องเป็นค่าสุ่มยาว ๆ (เช่น openssl rand -hex 32)
# ไม่มีค่าดีฟอลต์ในโค้ดโดยตั้งใจ (secret ที่ hardcode = ใครก็ปลอม token ได้)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_HOURS=12
# ผู้ใช้เริ่มต้นที่สร้างอัตโนมัติตอนบูต (idempotent) — เปลี่ยนรหัสก่อนใช้จริง
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin1234
# rate-limit ล็อกอินผิด (กัน brute force)
# LOGIN_MAX_FAILS=5
# LOGIN_FAIL_WINDOW_SEC=300
