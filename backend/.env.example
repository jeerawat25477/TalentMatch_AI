# TalentMatch AI — Backend environment (คัดลอกเป็น .env แล้วใส่ค่าจริง)

# Gemini (langchain-google-genai)
GOOGLE_API_KEY=your-gemini-api-key

# โมเดล (ไม่ใส่ก็ได้ — ดีฟอลต์ gemini-2.5-flash ทั้งคู่ ใช้ได้บน free tier)
# หมายเหตุ: Gemini 1.5 ตามบรีฟถูกปลดระวางแล้ว และ Pro ใช้ไม่ได้บน free tier (โควตา limit: 0)
# Free tier: โควตาเป็นแบบต่อโมเดล (2.5-flash หมดที่ 20 req/วัน) และ gemini-2.5-flash-lite
#   มีโควตาก้อนแยก จึงสลับไปใช้ได้เมื่อชนลิมิต
# เมื่อเปิด billing (Tier 1) ตั้ง GEMINI_COMPLEX_MODEL=gemini-2.5-pro เพื่อยกคุณภาพขั้น bias/matching
#   (Pro แพงกว่า Flash ราว 4 เท่า — ดูยอดที่หน้า Spend ใน AI Studio)
# GEMINI_DEFAULT_MODEL=gemini-2.5-flash
# GEMINI_COMPLEX_MODEL=gemini-2.5-pro

# ความทนทานต่อ rate limit (มีดีฟอลต์อยู่แล้ว ไม่ตั้งก็ได้)
# LLM_MAX_ATTEMPTS=5          # จำนวน retry สูงสุดต่อการเรียก LLM (exponential backoff)
# LLM_MAX_BACKOFF=60         # เพดานเวลาหน่วง (วินาที)
# GRAPH_MAX_CONCURRENCY=2    # จำนวนผู้สมัครที่รันกราฟพร้อมกัน (กันยิง LLM ทะลุ RPM)

# ---------- คิวงานประมวลผล + โควตารายวัน (app/queue_worker.py, app/llm_quota.py) ----------
# งานเบื้องหลังทั้งหมดอยู่ในตาราง processing_queue ไม่ใช่ BackgroundTasks แล้ว
# (รีสตาร์ตแล้วงานไม่หาย: แถวที่ค้าง 'running' ถูกกู้กลับเป็น 'queued' ตอนแอปบูต)
# GEMINI_DAILY_CHAT_QUOTA=20    # โควตา chat call ต่อวันต่อโมเดล (free tier = 20)
#                               # หลังเปิด billing ให้ปรับตามหน้า Rate Limit ใน AI Studio
#                               # (Tier 1: 2.5-flash = 10K RPD, 2.5-pro = 1K RPD) เช่น 500
#                               # ตั้ง 0 = ปิดการคุมโควตา (สำหรับแพลนเสียเงิน)
# GEMINI_QUOTA_TZ=America/Los_Angeles
#   เขตเวลาที่ใช้ตัดรอบโควตา — Google รีเซ็ต RPD ตอนเที่ยงคืน Pacific
#   ⚠️ เป็นสมมติฐานตามที่ Google ระบุ เรายังไม่เคยวัดจังหวะที่ 429 หายไปเอง
#   ถ้าสังเกตแล้วพบว่ามันรีเซ็ตตาม UTC ให้ตั้ง =UTC แล้วกลับพฤติกรรมเดิมได้ทันที
# QUEUE_POLL_SEC=10             # worker เช็คคิวทุกกี่วินาทีตอนคิวว่าง
# QUEUE_DEFERRED_RETRY_SEC=600  # งานที่ถูกพักเพราะโควตา รอกี่วินาทีก่อนลองใหม่
# QUEUE_MAX_ATTEMPTS=3          # ลองใหม่กี่ครั้งเมื่อล้มแบบชั่วคราว (โควตาหมดไม่นับ)
# STALLED_AFTER_SEC=90       # เกินเท่านี้แล้วยังไม่มีผลวิเคราะห์ = ขึ้นป้าย "วิเคราะห์ไม่สำเร็จ" ให้กดใหม่

# คลังเวกเตอร์ (ค้นหาผู้สมัครเก่าเชิงความหมาย — app/vectors.py)
# บรีฟระบุ models/text-embedding-004 แต่คีย์ปัจจุบันเรียกไม่ได้แล้ว (ไม่อยู่ใน ListModels)
# gemini-embedding-001 คืน 3072 มิติโดยดีฟอลต์ แต่ตัดเหลือ 768 ได้ (Matryoshka)
# ⚠️ EMBEDDING_DIM ต้องตรงกับ VECTOR(n) ใน app/schema.sql เสมอ — แก้ตัวหนึ่งต้องแก้อีกตัว
#    และถ้าเปลี่ยนค่านี้ต้อง index ใหม่ทั้งหมด (scripts/backfill_embeddings.py --all)
# EMBEDDING_MODEL=models/gemini-embedding-001
# EMBEDDING_DIM=768
# EMBEDDING_MAX_CHARS=8000   # ตัดข้อความ resume ก่อน embed

# Supabase Postgres connection string (โปรดักชัน). Local dev ใช้ DATABASE_URL จาก docker-compose แทนได้
SUPABASE_DB_URL=postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres

# LangSmith tracing — ตั้ง 2 บรรทัดแรกแล้ว tracing เปิดเอง (SDK มีในตัว ไม่ต้องแก้โค้ด)
# ทุก call ของ LLM/embeddings/กราฟจะส่ง trace ขึ้น LangSmith · ปิดโดยลบคีย์หรือตั้ง =false
# SDK รองรับทั้งชื่อ LANGCHAIN_* (นี้) และ LANGSMITH_* (เวอร์ชันใหม่) — ใช้ตัวไหนก็ได้
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your-langsmith-key
LANGCHAIN_PROJECT=talentmatch-ai    # ชื่อ project ที่จะเห็นใน LangSmith UI

# ---------- ส่งอีเมล (SMTP) ----------
# docker-compose ไม่ตั้งค่า SMTP ให้ — ต้องเลือกหนึ่งชุดใน .env (ไม่ตั้ง SMTP_HOST = กดส่งแล้วขึ้น error)
# ทดสอบ: ส่งเข้า MailHog (กล่องจดหมายปลอม) ดูอีเมลที่ http://localhost:8025 — ไม่ถึงผู้รับจริง
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_STARTTLS=false
SMTP_FROM=recruit@talentmatch.local
# ส่งจริง: ลบชุดบนแล้วใช้ชุดนี้ เช่น Gmail (ต้องเปิด 2FA แล้วสร้าง App Password)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_STARTTLS=true
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=your-16-char-app-password   # App Password ไม่ใช่รหัสผ่านบัญชี
# SMTP_FROM=recruit@yourcompany.com

# ---------- ปากทางรับใบสมัครทางอีเมล (app/email_intake.py) ----------
# worker ดึงเมลจากกล่อง IMAP → จับคู่ตำแหน่งงานจาก apply+<job_id>@ → สร้างผู้สมัคร → เข้าคิว
# ⚠️ **ดีฟอลต์ปิดเสมอ** สวิตช์อยู่ใน DB (ตาราง app_settings) เปิดจากหน้าตั้งค่าได้ไม่ต้องรีสตาร์ต
# ⚠️ ไม่ครบ 3 ตัวแรก = ฟีเจอร์นี้ปิดถาวร (log บอกตอนบูต) · ห้ามใส่ค่าพวกนี้ผ่าน API เด็ดขาด
# ⚠️ worker อ่านเมลอย่างเดียว ไม่ mark-read ไม่ย้าย ไม่ลบ และ **ไม่ตอบกลับ** —
#    อีเมลถึงผู้สมัครยังต้องให้ HR กดยืนยันเองเสมอ (กันเป็น spam relay)
# IMAP_HOST=imap.gmail.com
# IMAP_USER=recruit@yourcompany.com
# IMAP_PASSWORD=your-16-char-app-password   # App Password ตัวเดียวกับ SMTP ใช้ได้
# IMAP_PORT=993
# IMAP_MAILBOX=INBOX
# IMAP_POLL_SECONDS=120     # ดึงเมลทุกกี่วินาที (ลูปตื่นถี่กว่านี้เพื่อให้สวิตช์มีผลเร็ว)

# ---------- ลิมิตการอัปโหลด (กัน DoS) ----------
# MAX_UPLOAD_MB=10    # ขนาดสูงสุดต่อไฟล์
# MAX_FILES=20        # จำนวนไฟล์สูงสุดต่อการอัปโหลดหนึ่งครั้ง
# MAX_PDF_PAGES=30    # แกะข้อความแค่ N หน้าแรก กัน PDF ที่ไฟล์เล็กแต่แตกเป็นข้อความมหาศาล
# MIN_RESUME_TEXT_CHARS=80  # สั้นกว่านี้ = ถือว่าอ่านไม่ออก (เรซูเม่สแกน) ปฏิเสธตั้งแต่ตอนอัปโหลด

# ---------- RAG (retrieval agent หาผู้สมัครคล้ายกัน) ----------
# feature เสริม เปิด/ปิดได้ · ใช้ embedding quota (แยกจาก chat 20/วัน) จึงเปิดทิ้งไว้ได้
# RAG_ENABLED=true      # false = โหนด retrieve_similar เป็น no-op กราฟรันเหมือนเดิม
# RAG_TOP_K=3           # จำนวนผู้สมัครคล้ายที่ดึงมา

# ---------- CORS ----------
# โดเมนของหน้าเว็บที่อนุญาตให้เรียก API คั่นด้วยจุลภาค · ไม่ตั้ง = localhost:3000,4000 (dev)
# โปรดักชัน docker-compose.prod.yml ตั้งให้อัตโนมัติจาก PUBLIC_DOMAIN ไม่ต้องใส่ที่นี่
# ห้ามใส่ * (คู่กับ allow_credentials เบราว์เซอร์ปฏิเสธอยู่แล้ว และถ้าใช้ได้ก็อันตราย)
# ALLOWED_ORIGINS=https://talentmatch.example.com

# ---------- Auth (ล็อกอิน) ----------
# JWT_SECRET จำเป็นเสมอ — โปรดักชันต้องเป็นค่าสุ่มยาว ๆ (เช่น openssl rand -hex 32)
# ไม่มีค่าดีฟอลต์ในโค้ดโดยตั้งใจ (secret ที่ hardcode = ใครก็ปลอม token ได้)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_HOURS=12
# ผู้ใช้เริ่มต้นที่สร้างอัตโนมัติตอนบูต (idempotent) — เปลี่ยนรหัสก่อนใช้จริง
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin1234
# rate-limit ล็อกอินผิด (กัน brute force)
# LOGIN_MAX_FAILS=5
# LOGIN_FAIL_WINDOW_SEC=300
